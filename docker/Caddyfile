# Домен берётся из переменной DOMAIN (файл .env). Caddy сам получает
# и продлевает бесплатный TLS-сертификат Let's Encrypt для этого домена.
{$DOMAIN} {
	encode gzip

	# Всё — приложению: статику раздаёт WhiteNoise внутри web, загруженные файлы
	# отдаёт само приложение (решает, что можно показать в браузере).
	reverse_proxy web:8000
}
