# ============================================================
#  Продакшн-конфигурация. Скопируйте в .env на сервере и заполните.
#  ВАЖНО: SECRET_KEY и пароли держите в секрете, .env не коммитьте.
# ============================================================

# Сгенерируйте ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ЗАМЕНИТЕ-НА-СЛУЧАЙНЫЙ-КЛЮЧ

DEBUG=False

# Домен(ы) и IP сервера через запятую
ALLOWED_HOSTS=sklad.example.com,203.0.113.10

# Для HTTPS укажите полный адрес со схемой (можно несколько через запятую)
CSRF_TRUSTED_ORIGINS=https://sklad.example.com

# --- База данных PostgreSQL (хост = имя сервиса compose "db") ---
POSTGRES_DB=sklad
POSTGRES_USER=sklad
POSTGRES_PASSWORD=ЗАМЕНИТЕ-НА-ПАРОЛЬ
DATABASE_URL=postgres://sklad:ЗАМЕНИТЕ-НА-ПАРОЛЬ@db:5432/sklad

# --- Первый администратор (создаётся при первом запуске) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ЗАМЕНИТЕ-НА-ПАРОЛЬ

# --- Почта (отправка счетов на email) ---
# Если EMAIL_HOST пустой — письма пишутся в консоль (реально не уходят).
# Пример для Яндекс 360: smtp.yandex.ru, порт 465, SSL. Для Gmail — пароль приложения.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Адрес отправителя во всех письмах
DEFAULT_FROM_EMAIL=sklad@example.com

# --- Дополнительно ---
# «Заполнить по ИНН» — бесплатный ключ с dadata.ru
DADATA_API_KEY=
# Разрешить отрицательные остатки при отгрузке
ALLOW_NEGATIVE_STOCK=False

# Включите ПОСЛЕ настройки HTTPS (иначе по http вход не сработает):
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
